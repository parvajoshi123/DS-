#include <stdio.h>
#include <ctype.h>   


int stack[100];
int top = -1;

void push(int x) {
    stack[++top] = x;
}

int pop() {
    return stack[top--];
}

int evaluatePostfix(char exp[]) {
    int i;
    for(i = 0; exp[i] != '\0'; i++) {
        char ch = exp[i];
        if(isdigit(ch)) {
            push(ch - '0');  
        } else {
            int b = pop();
            int a = pop();
            switch(ch) {
                case '+': push(a + b); break;
                case '-': push(a - b); break;
                case '*': push(a * b); break;
                case '/': push(a / b); break;
            }
        }
    }
    return pop(); 
}

int main() {
    char exp[] = "53+82-*";   
    printf("Postfix: %s\n", exp);
    printf("Result: %d\n", evaluatePostfix(exp));
    return 0;
}
