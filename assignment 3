#include <stdio.h>
#include <string.h>
#define MAX 50
struct Student {
    int rollNo;
    char name[50];
    float marks;
};
void display(struct Student students[], int n);
void insertionSort(struct Student students[], int n);
void selectionSort(struct Student students[], int n);
void shellSort(struct Student students[], int n);
int linearSearch(struct Student students[], int n, int rollNo);
int binarySearch(struct Student students[], int n, int rollNo);
int main() {
    struct Student students[MAX];
    int n, choice, rollNo, pos;
    printf("Enter number of students: ");
    scanf("%d", &n);
    for (int i = 0; i < n; i++) {
        printf("\nEnter details of student %d:\n", i + 1);
        printf("Roll No: ");
        scanf("%d", &students[i].rollNo);
        printf("Name: ");
        scanf("%s", students[i].name);
        printf("Marks: ");
        scanf("%f", &students[i].marks);
    }

    do {
        printf("\n--- MENU ---\n");
        printf("1. Display Students\n");
        printf("2. Insertion Sort (by Roll No)\n");
        printf("3. Selection Sort (by Roll No)\n");
        printf("4. Shell Sort (by Roll No)\n");
        printf("5. Linear Search (by Roll No)\n");
        printf("6. Binary Search (by Roll No)\n");
        printf("0. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                display(students, n);
                break;
            case 2:
                insertionSort(students, n);
                printf("Sorted using Insertion Sort.\n");
                break;
            case 3:
                selectionSort(students, n);
                printf("Sorted using Selection Sort.\n");
                break;
            case 4:
                shellSort(students, n);
                printf("Sorted using Shell Sort.\n");
                break;
            case 5:
                printf("Enter Roll No to search: ");
                scanf("%d", &rollNo);
                pos = linearSearch(students, n, rollNo);
                if (pos != -1)
                    printf("Found at position %d: %s (Marks: %.2f)\n", pos + 1, students[pos].name, students[pos].marks);
                else
                    printf("Not found.\n");
                break;
            case 6:
                printf("Enter Roll No to search: ");
                scanf("%d", &rollNo);
                pos = binarySearch(students, n, rollNo);
                if (pos != -1)
                    printf("Found at position %d: %s (Marks: %.2f)\n", pos + 1, students[pos].name, students[pos].marks);
                else
                    printf("Not found.\n");
                break;
        }
    } while (choice != 0);
    return 0;
}
void display(struct Student students[], int n) {
    printf("\nRollNo\tName\tMarks\n");
    for (int i = 0; i < n; i++) {
        printf("%d\t%s\t%.2f\n", students[i].rollNo, students[i].name, students[i].marks);
    }

