#include <stdio.h>
#define MAX 10

typedef struct {
    int jobID;
    char title[30];
} PrintJob;

PrintJob queue[MAX];
int front = -1, rear = -1;

void enqueue(PrintJob job) {
    if (rear == MAX-1) {
        printf("Queue Full!\n");
        return;
    }
    if (front == -1) front = 0;
    queue[++rear] = job;
    printf("Job %d added.\n", job.jobID);
}

void dequeue() {
    if (front == -1) {
        printf("Queue Empty!\n");
        return;
    }
    printf("Processing Job %d: %s\n", queue[front].jobID, queue[front].title);
    if (front == rear) front = rear = -1;
    else front++;
}

void display() {
    if (front == -1) {
        printf("No jobs in queue.\n");
        return;
    }
    printf("Pending Jobs:\n");
    for (int i = front; i <= rear; i++)
        printf("Job %d: %s\n", queue[i].jobID, queue[i].title);
}

int main() {
    PrintJob j1 = {1, "Report.pdf"};
    PrintJob j2 = {2, "Invoice.docx"};
    enqueue(j1);
    enqueue(j2);
    display();
    dequeue();
    display();
    return 0;
}
