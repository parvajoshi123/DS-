#include <stdio.h>
#include <stdlib.h>
struct Node {
    int coeff, exp;
    struct Node *next;
};
struct Node *createNode(int c, int e) {
    struct Node *n = malloc(sizeof(struct Node));
    n->coeff = c;
    n->exp = e;
    n->next = n;
    return n;
}
void insert(struct Node **head, int c, int e) {
    struct Node *n, *t;
    if (c == 0)
        return;
    if (*head == NULL) {
        *head = createNode(c, e);
        return;
    }
    t = *head;
    do {
        if (t->exp == e) {
            t->coeff += c;
            return;
        }
        t = t->next;
    } while (t != *head);
    n = createNode(c, e);
    t = *head;
    while (t->next != *head)
        t = t->next;
    t->next = n;
    n->next = *head;
}
struct Node *createPoly() {
    struct Node *p = NULL;
    int n, c, e, i;
    printf("Enter number of terms: ");
    scanf("%d", &n);
    for (i = 0; i < n; i++) {
        printf("Enter coefficient and exponent: ");
        scanf("%d%d", &c, &e);
        insert(&p, c, e);
    }
    return p;
}
void display(struct Node *p) {
    struct Node *t;
    if (p == NULL) {
        printf("0\n");
        return;
    }
    t = p;
    do {
        if (t->coeff != 0)
            printf("%+dx^%d ", t->coeff, t->exp);
        t = t->next;
    } while (t != p);
    printf("\n");
}
struct Node *addPoly(struct Node *p, struct Node *q) {
    struct Node *r = NULL, *t;
    if (p != NULL) {
        t = p;
        do {
            insert(&r, t->coeff, t->exp);
            t = t->next;
        } while (t != p);
    }
    if (q != NULL) {
        t = q;
        do {
            insert(&r, t->coeff, t->exp);
            t = t->next;
        } while (t != q);
    }
    return r;
}
int main() {
    struct Node *p, *q, *r;
    printf("First polynomial:\n");
    p = createPoly();
    printf("Second polynomial:\n");
    q = createPoly();
    printf("First polynomial: ");
    display(p);
    printf("Second polynomial: ");
    display(q);
    r = addPoly(p, q);
    printf("Sum: ");
    display(r);
    return 0;
}
